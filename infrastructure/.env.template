# Copy this file to .env, next to docker-compose.yml.

# The password of the database. Use only letters and digits: it goes into a URL.
POSTGRES_PASSWORD=

# The https address of the server. The reverse proxy serves it.
HALINKA_PUBLIC_URL=https://halinka.example.com

# Make each one with: openssl rand -base64 32
HALINKA_AUTH_SECRET=
# Keep a copy outside the server. Without it, the stored keys cannot be read.
HALINKA_MASTER_KEY=

# A GitHub OAuth App. Its callback URL is <HALINKA_PUBLIC_URL>/api/auth/callback/github
HALINKA_GITHUB_CLIENT_ID=
HALINKA_GITHUB_CLIENT_SECRET=
# The GitHub login of the first Admin.
HALINKA_ADMIN_GITHUB=

# The address of the reverse proxy as the server sees it. A proxy on this machine comes through the gateway of
# the Compose network. If it is wrong, all clients share one rate limit (docs/user/vps.md).
HALINKA_TRUSTED_PROXY=172.30.0.1

# The port on localhost that the reverse proxy reaches.
HALINKA_PORT=7070
