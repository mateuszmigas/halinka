{
  "name": "@halinka/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.docker.test.ts'",
