    "@halinka/workflow": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7",
    "@orpc/json-schema": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/openapi-client": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/zod": "1.15.7",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@halinka/config": "workspace:*",
