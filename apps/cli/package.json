{
  "name": "halinka",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hostable agent orchestration for the software development lifecycle",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "halinka": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts start",
    "build": "node --import tsx build.ts",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@clack/prompts": "^1.8.1",
    "@devcontainers/cli": "0.89.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.6",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7",
    "@orpc/json-schema": "1.15.7",
    "@orpc/openapi": "1.15.7",
    "@orpc/openapi-client": "1.15.7",
    "@orpc/server": "1.15.7",
    "@orpc/zod": "1.15.7",
    "better-auth": "^1.7.15",
    "birpc": "^4.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "ssh2": "1.17.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@halinka/config": "workspace:*",
    "@halinka/portal": "workspace:*",
    "@halinka/presets": "workspace:*",
    "@halinka/protocol": "workspace:*",
    "@halinka/runner": "workspace:*",
    "@halinka/sandbox": "workspace:*",
    "@halinka/server": "workspace:*",
    "@halinka/utils": "workspace:*",
    "@halinka/workflow": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
